digraph AFD {
  rankdir=LR; nodesep=0.5; ranksep=0.45;
  node [shape=circle, fontname="DejaVu Sans", fontsize=20, width=0.75, fixedsize=true];
  edge [fontname="DejaVu Sans Mono", fontsize=18];
  inicio [shape=point, width=0.1];
  q0;
  q1;
  q2;
  q3;
  q4;
  q5;
  q6;
  q7 [shape=doublecircle, style=filled, fillcolor="#e8f4ea"];
  q8 [shape=doublecircle, style=filled, fillcolor="#e8f4ea"];
  q9;
  q10;
  q11;
  inicio -> q0;
  q0 -> q1 [label=" a-z, 0-9, '_' "];
  q1 -> q1 [label=" a-z, 0-9, '_' "];
  q1 -> q2 [label=" '.' "];
  q1 -> q3 [label=" '@' "];
  q2 -> q1 [label=" a-z, 0-9, '_' "];
  q3 -> q4 [label=" a-z, 0-9 "];
  q4 -> q4 [label=" a-z, 0-9 "];
  q4 -> q5 [label=" '.' "];
  q4 -> q10 [label=" '-' "];
  q5 -> q6 [label=" a-z "];
  q5 -> q9 [label=" 0-9 "];
  q6 -> q7 [label=" a-z "];
  q6 -> q9 [label=" 0-9 "];
  q6 -> q5 [label=" '.' "];
  q6 -> q11 [label=" '-' "];
  q7 -> q8 [label=" a-z "];
  q7 -> q9 [label=" 0-9 "];
  q7 -> q5 [label=" '.' "];
  q7 -> q11 [label=" '-' "];
  q8 -> q9 [label=" a-z, 0-9 "];
  q8 -> q5 [label=" '.' "];
  q8 -> q11 [label=" '-' "];
  q9 -> q9 [label=" a-z, 0-9 "];
  q9 -> q5 [label=" '.' "];
  q9 -> q11 [label=" '-' "];
  q10 -> q4 [label=" a-z, 0-9 "];
  q10 -> q10 [label=" '-' "];
  q11 -> q9 [label=" a-z, 0-9 "];
  q11 -> q11 [label=" '-' "];
  label="As transições que não aparecem (e os símbolos fora de Σ) vão para o poço qp.";
  labelloc=b; fontname="DejaVu Sans"; fontsize=18;
}
