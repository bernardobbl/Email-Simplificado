digraph AFD {
  rankdir=LR; nodesep=0.5; ranksep=0.45;
  node [shape=circle, fontname="DejaVu Sans", fontsize=20, width=0.75, fixedsize=true];
  edge [fontname="DejaVu Sans Mono", fontsize=18];
  inicio [shape=point, width=0.1];
  q0;
  q1;
  q2;
  q3;
  q4;
  q5;
  q6;
  q7 [shape=doublecircle, style=filled, fillcolor="#e8f4ea"];
  q8 [shape=doublecircle, style=filled, fillcolor="#e8f4ea"];
  q9;
  qp [style=dashed, color="#999999", fontcolor="#777777"];
  inicio -> q0;
  q0 -> q1 [label=" a-z, 0-9, '_' "];
  q0 -> qp [label=" '.', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q1 -> q1 [label=" a-z, 0-9, '_' "];
  q1 -> q2 [label=" '.' "];
  q1 -> q3 [label=" '@' "];
  q2 -> q1 [label=" a-z, 0-9, '_' "];
  q2 -> qp [label=" '.', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q3 -> q4 [label=" a-z, 0-9 "];
  q3 -> qp [label=" '.', '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q4 -> q4 [label=" a-z, 0-9 "];
  q4 -> q5 [label=" '.' "];
  q4 -> qp [label=" '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q5 -> q6 [label=" a-z "];
  q5 -> q9 [label=" 0-9 "];
  q5 -> qp [label=" '.', '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q6 -> q7 [label=" a-z "];
  q6 -> q9 [label=" 0-9 "];
  q6 -> q5 [label=" '.' "];
  q6 -> qp [label=" '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q7 -> q8 [label=" a-z "];
  q7 -> q9 [label=" 0-9 "];
  q7 -> q5 [label=" '.' "];
  q7 -> qp [label=" '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q8 -> q9 [label=" a-z, 0-9 "];
  q8 -> q5 [label=" '.' "];
  q8 -> qp [label=" '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  q9 -> q9 [label=" a-z, 0-9 "];
  q9 -> q5 [label=" '.' "];
  q9 -> qp [label=" '_', '@' ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
  qp -> qp [label=" Σ ", style=dashed, color="#aaaaaa", fontcolor="#999999"];
}
